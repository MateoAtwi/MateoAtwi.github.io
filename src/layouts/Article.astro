---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** e.g. "Dec 1, 2017 - Mateo Atwi", shown under the title like the old post layout */
  meta?: string;
  /** Nav section to highlight */
  section?: string;
  noindex?: boolean;
  showTitle?: boolean;
}

const { title, description, image, meta, section, noindex, showTitle = true } = Astro.props;
---

<Base title={title} description={description} image={image} noindex={noindex} section={section} type="article">
  <article class="card">
    {showTitle && <h1>{title}</h1>}
    {meta && <p class="post-meta">{meta}</p>}
    <slot />
    <slot name="after" />
  </article>
</Base>

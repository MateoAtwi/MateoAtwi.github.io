---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/content';

const entries = await getWork();

// Each entry's Markdown body holds the long description, optionally followed by a "### Code sample" section.
const items = await Promise.all(
  entries.map(async (entry) => {
    await render(entry);
    const html = entry.rendered?.html ?? '';
    const split = html.search(/<h3[^>]*>Code sample<\/h3>/i);
    return {
      entry,
      description: (split === -1 ? html : html.slice(0, split)).trim(),
      code: split === -1 ? '' : html.slice(split).replace(/<h3[^>]*>Code sample<\/h3>/i, '').trim(),
    };
  }),
);

const groups = [
  { id: 'work', title: 'Work', items: items.filter((i) => i.entry.data.kind === 'work') },
  { id: 'education', title: 'Education', items: items.filter((i) => i.entry.data.kind === 'education') },
];

const heading = (d: (typeof entries)[number]['data']) => (d.role ? `${d.role} at ` : '');
const tocLabel = (d: (typeof entries)[number]['data']) => {
  const dup = entries.filter((e) => e.data.org === d.org).length > 1;
  return `${heading(d)}${d.org}${dup ? ` (${d.period})` : ''}`;
};
---

<Base
  title="Work & Education"
  description="Mateo Atwi's work history and education: US Frame Factory, Boxy, BMarko Structures, Stuller, NASA Johnson Space Center, Landis+Gyr and Georgia Tech."
>
  <article class="card">
    <p>
      This is a summary of all my work and education. Check out <a href="/projects/">my projects page</a> for more fleshed
      out descriptions and examples from my projects of the last few years.
    </p>

    <nav aria-label="On this page">
      <ul class="toc">
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>{g.title}</a>
              <ul>
                {g.items.map(({ entry }) => (
                  <li>
                    <a href={`#${entry.id}`}>{tocLabel(entry.data)}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((g) => (
        <section class="group" aria-labelledby={g.id}>
          <h1 id={g.id} class="section-title">
            {g.title}
          </h1>
          {g.items.map(({ entry, description, code }) => {
            const d = entry.data;
            return (
              <section class="job" id={entry.id} aria-labelledby={`${entry.id}-title`}>
                <h2 id={`${entry.id}-title`}>
                  {heading(d)}
                  {d.orgUrl ? <a href={d.orgUrl}>{d.org}</a> : d.org}
                </h2>
                {d.blurb && (
                  <blockquote>
                    <p>{d.blurb}</p>
                  </blockquote>
                )}
                <p>
                  <em>{d.period}</em>
                </p>
                {d.skills.length > 0 && <h3>Skills: {d.skills.join(', ')}</h3>}
                {d.highlights.length > 0 && (
                  <>
                    <h3>Summary</h3>
                    <ul>
                      {d.highlights.map((h) => (
                        <li set:html={h} />
                      ))}
                    </ul>
                  </>
                )}
                {description && (
                  <details class="disclosure">
                    <summary>Description</summary>
                    <div class="details-body prose" set:html={description} />
                  </details>
                )}
                {code && (
                  <details class="disclosure">
                    <summary>Code Sample</summary>
                    <div class="details-body prose" set:html={code} />
                  </details>
                )}
                {d.photos.length > 0 && (
                  <div class="separator photos">
                    {d.photos.map((p) => (
                      <a href={p.href ?? p.src.src}>
                        <Image src={p.src} alt={`Photo from ${d.org}`} widths={[400, 800]} sizes="(min-width: 800px) 350px, 90vw" />
                      </a>
                    ))}
                  </div>
                )}
              </section>
            );
          })}
        </section>
      ))
    }
  </article>
</Base>

<style>
  .toc ul {
    list-style: circle;
  }

  .group {
    margin-top: 2em;
  }

  .job {
    margin-top: 1.75em;
  }

  .job > * + * {
    margin-top: 0.85em;
  }

  .photos > a {
    flex: 0 1 49%;
  }

  .photos :global(img) {
    max-height: 400px;
    width: 100%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .photos > a {
      flex-basis: 100%;
    }
  }
</style>

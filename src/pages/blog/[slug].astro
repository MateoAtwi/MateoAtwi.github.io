---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Pager from '../../components/Pager.astro';
import { getBlogPosts, topicSlug } from '../../lib/content';
import { formatDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  // Articles hosted elsewhere (`link`) link straight out and get no page here.
  const posts = (await getBlogPosts()).filter((p) => !p.data.link); // newest first
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: posts[i - 1] && { href: `/blog/${posts[i - 1].id}/`, title: posts[i - 1].data.title },
      older: posts[i + 1] && { href: `/blog/${posts[i + 1].id}/`, title: posts[i + 1].data.title },
    },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, date, updated, topics, summary } = entry.data;
---

<Article title={title} description={summary} section="/blog/">
  <p class="post-meta">
    {formatDate(date)} - Mateo Atwi ·{' '}
    {
      topics.map((t, i) => (
        <>
          {i > 0 && ', '}
          <a href={`/blog/#${topicSlug(t)}`}>{t}</a>
        </>
      ))
    }
    {updated && <span> · Updated {formatDate(updated)}</span>}
  </p>
  <div class="prose">
    <Content />
  </div>
  <Pager
    slot="after"
    prev={older}
    next={newer}
    prevLabel="Older"
    nextLabel="Newer"
    back={{ href: '/blog/', title: 'Back to the blog' }}
  />
</Article>

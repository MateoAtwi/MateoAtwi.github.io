---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/site/portrait.jpg';
import projects1 from '../assets/site/home-projects-1.jpg';
import projects2 from '../assets/site/home-projects-2.jpg';

const logos = [
  { src: '/assets/images/logos/meatball.png', alt: 'NASA JSC', href: '/work&education/#advanced-exercise-intern-at-nasa-johnson-space-center-spring-2019' },
  { src: '/assets/images/logos/landisGyr.png', alt: 'Landis + Gyr', href: '/work&education/#mechanical-intern-at-landisgyr' },
  { src: '/assets/images/logos/stuller.png', alt: 'Stuller', href: '/work&education/#research--development-intern-at-stuller' },
  { src: '/assets/images/logos/bmarko.png', alt: 'BMarko Structures', href: '/work&education/#special-projects-lead-vp-of-operations-and-operations-manager-at-bmarko-structures' },
];

const skills: [string, string][] = [
  ['CAD (Solidworks, Creo Parametric, Fusion)', 'Matlab (Post-analysis)'],
  ['Prototyping & Fabrication (Waterjet, Laser Cutters)', 'Python (Raspberry Pi Sensor Reading, ZMQ, Protobuf)'],
  ['3D Printing (Test Parts, Mounts)', 'Labview (Mechatronics, Data Acquisition)'],
  ['Testing (IP-67, Hardware Test Plan)', 'C# (Unity Game Development)'],
  ['Design (Sensor and Motor Mounts, Electric Long Board, Model Rockets)', 'ZMQ (Sending/receiving Data and Commands)'],
  ['Sensors (I2C, SPI, Analog)', 'Protobuf (Serializing Data)'],
  ['Fuel Cell Systems', 'Java (Classwork)'],
  ['Analysis (Classwork, Homer, Ansys)', 'C (Basic Understanding)'],
  ['Documentation (Test Plan, Gitlab)', 'Linux OS'],
];

const goals = [
  'Grow Boxy to the point where it is an industry leading modular construction company',
  'Work in the space industry at a fast paced company',
  'Give back to communities',
  'Challenge myself in my work',
  'Practice and take on technical leadership roles',
];

const interests = [
  'Construction',
  'Modular',
  'Space industry',
  'Challenging development work',
  'Data acquisition and sensors',
  'Programming',
  'Prototyping & fabrication',
  'Design & analysis',
];
---

<Base>
  <article class="card home">
    <h1 class="site-name">Mateo Atwi</h1>
    <p class="centered">
      <Image src={portrait} alt="Mateo Atwi" class="portrait" widths={[200, 400]} sizes="200px" loading="eager" fetchpriority="high" />
    </p>

    <blockquote>
      <p>
        I am a determined and inquisitive young engineer looking to use my skills and energy to make a positive impact on the
        communities that I work and live in.
      </p>
    </blockquote>

    <p>
      My brother, Tiago, and I currently run US Frame Factory. <a href="https://usframefactory.com/">US Frame Factory</a> is
      an on demand manufacturer and full service framing supply company that strives to rethink how we approach construction.
      Our ultimate goal being to decrease cost, increase quality, and create satisfying good jobs for hard workers. You can also
      buy accessory steel framing products at <a href="https://clips.usframefactory.com/">our online accessories store</a>.
    </p>

    <ul>
      <li><a href="/work&education/">Work and Education</a></li>
      <li><a href="/projects/">Projects</a></li>
      <li><a href="#skills-list">Skills List</a></li>
      <li><a href="#goals">Goals</a></li>
      <li><a href="#interests">Interests</a></li>
    </ul>

    <h2 class="section-title"><a href="/work&education/">Work and Education</a></h2>
    <p>Check out my <a href="/work&education/">Work &amp; Education</a> tab for more detailed information.</p>
    <div class="logos">
      <a class="gt" href="/work&education/#current-bachelors-in-mechanical-engineering-at-georgia-tech">
        <img src="/assets/images/logos/gt.png" alt="Georgia Institute of Technology" />
      </a>
      {
        logos.map((l) => (
          <a href={l.href}>
            <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
          </a>
        ))
      }
    </div>

    <h2 class="section-title"><a href="/projects/">Projects</a></h2>
    <p>
      I have experience in team management, hardware development, and software development. Check out my <a href="/projects/"
        >Projects</a
      > tab for more detailed information.
    </p>
    <div class="separator">
      <a href="/internSpaceProgram/"><Image src={projects1} alt="NASA intern rocketry team with our rocket" widths={[400, 700]} sizes="(min-width: 800px) 333px, 90vw" /></a>
      <a href="/me2110/"><Image src={projects2} alt="Mateo with his ME 2110 competition robot" widths={[400, 700]} sizes="(min-width: 800px) 333px, 90vw" /></a>
    </div>

    <h2 class="section-title" id="skills-list">Skills List</h2>
    <p>Although I trained as a mechanical engineer, I have tried many different things in different fields, highlighting my ability to learn.</p>
    <table>
      <thead>
        <tr><th scope="col">Hardware</th><th scope="col">Software</th></tr>
      </thead>
      <tbody>
        {
          skills.map(([hw, sw]) => (
            <tr>
              <td>{hw}</td>
              <td>{sw}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 class="section-title" id="goals">Goals</h2>
    <ul>
      {goals.map((g) => <li>{g}</li>)}
    </ul>

    <h2 class="section-title" id="interests">Interests</h2>
    <ul>
      {interests.map((i) => <li>{i}</li>)}
    </ul>
  </article>
</Base>

<style>
  .home .site-name {
    text-align: center;
    font-size: clamp(40px, 9vw, 60px);
    line-height: 1.1;
    margin-top: 6px;
  }

  .home :global(.portrait) {
    border-radius: 50%;
    width: 50%;
    max-width: 200px;
    margin: auto;
  }

  .section-title a,
  .section-title a:visited {
    color: inherit;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 2%;
  }

  .logos a {
    flex: 0 1 23%;
  }

  .logos a.gt {
    flex-basis: 78%;
  }

  .logos img {
    width: 100%;
    max-width: 100%;
  }

  .logos a:not(.gt) img {
    max-height: 110px;
    object-fit: contain;
  }

  .separator > a {
    flex: 1 1 0;
    min-width: 0;
  }

  .separator :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 250px;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .logos a {
      flex-basis: 45%;
    }
    .separator > a {
      flex-basis: 100%;
    }
  }
</style>

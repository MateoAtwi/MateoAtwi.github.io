---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import banner from '../assets/site/collections.jpg';

const pages = new Map((await getCollection('pages')).map((p) => [p.data.slug, p.data.title]));
const page = (slug: string) => ({ href: `/${slug}/`, name: pages.get(slug) ?? slug });

const groups = [
  { subject: 'Personal', modules: [page('books&movies'), page('quotes'), page('words')] },
  { subject: 'Travel', modules: [{ href: '/csp/', name: 'CSP (China Summer Program)' }] },
  { subject: 'Personal Projects', modules: [page('3dprinting')] },
];
---

<Base title="Collections" description="Collections of things and blogs that document what Mateo Atwi has done and wants to do.">
  <article class="card">
    <h1>Collections and Blogs</h1>
    <p>The following are collections of things and different blogs that document the things I have done and the things I want to do.</p>
    <p class="centered">
      <Image src={banner} alt="" widths={[640, 1200]} sizes="(min-width: 800px) 710px, 95vw" />
    </p>
    {
      groups.map((g) => (
        <section aria-labelledby={`g-${g.subject}`}>
          <h2 class="section-title" id={`g-${g.subject}`}>
            {g.subject}
          </h2>
          <ul>
            {g.modules.map((m) => (
              <li>
                <h4>
                  <a href={m.href}>{m.name}</a>
                </h4>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</Base>

<style>
  section {
    margin-top: 1.5em;
  }

  ul {
    margin-top: 0.6em;
  }
</style>

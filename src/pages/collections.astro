---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import banner from '../assets/site/collections.jpg';
import { getCspPosts } from '../lib/content';

const pages = new Map((await getCollection('pages')).map((p) => [p.data.slug, p]));
const csp = await getCspPosts();

const groups = [
  {
    subject: 'Personal',
    items: [
      { slug: 'books&movies', note: 'Books I have finished, books in progress, and favorite movies.' },
      { slug: 'quotes', note: 'Favorite lines from books, people and scripture.' },
      { slug: 'words', note: 'New words picked up along the way.' },
    ],
  },
  {
    subject: 'Travel',
    items: [{ href: '/csp/', title: 'China Summer Program', note: `${csp.length} posts from the summer of 2017 in China.` }],
  },
  {
    subject: 'Personal projects',
    items: [{ slug: '3dprinting', note: 'Notes from getting into 3D printing with a Prusa i3 MK3S.' }],
  },
].map((g) => ({
  ...g,
  items: g.items
    .map((item) => ('slug' in item ? { href: `/${item.slug}/`, title: pages.get(item.slug!)?.data.title ?? item.slug, note: item.note } : item))
    .filter(Boolean),
}));

---

<Base title="Collections" description="Collections of things and blogs that document what Mateo Atwi has done and wants to do.">
  <header class="wrap page-head">
    <p class="eyebrow"><span class="dot"></span>Notebook</p>
    <h1>Collections &amp; blogs</h1>
    <p class="lede">Collections of things and different blogs that document the things I have done and the things I want to do.</p>
  </header>

  <div class="wrap">
    <Image class="banner" src={banner} alt="" widths={[640, 1200, 1800]} sizes="(min-width: 72rem) 68rem, 100vw" />
    <div class="groups">
      {
        groups.map((g) => (
          <section aria-labelledby={`g-${g.subject}`}>
            <h2 class="eyebrow" id={`g-${g.subject}`}>
              {g.subject}
            </h2>
            <ul>
              {g.items.map((item) => (
                <li>
                  <a href={item.href}>
                    <span class="t">{item.title}</span>
                    <span class="n">{item.note}</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .banner {
    display: block;
    width: 100%;
    max-height: 22rem;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .groups {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 56rem) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  h2 {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ink);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .t {
    font-weight: 650;
    font-size: 1.1rem;
  }

  .n {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    color: var(--accent);
    transition: translate 0.2s ease;
  }

  li a:hover .t {
    color: var(--accent);
  }

  li a:hover .arrow {
    translate: 4px 0;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { Content } from '../private/anna.md';
---

<!--
  Unlisted page carried over from the original site. The "password" is only a
  client-side curtain (exactly as before): it is not real access control.
-->
<Base title="Anna" noindex>
  <article class="card">
    <header>
      <p>This website is only for Anna. Please use the password to unlock.</p>
      <form class="gate" id="gate">
        <label class="visually-hidden" for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Password" autocomplete="off" required />
        <button type="submit">Unlock</button>
        <p class="error" id="gate-error" role="alert" hidden>That's not it. Try again.</p>
      </form>
    </header>
    <div id="letters" hidden>
      <p class="countdown" data-until="2019-07-10T20:00:00-05:00" data-msg=" till Anna returns to the US!" data-done="Anna is home!"></p>
      <p class="countdown" data-until="2019-07-18T17:35:12-05:00" data-msg=" till Anna visits Mateo in Louisiana!" data-done="Anna is here!"></p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<script>
  const form = document.getElementById('gate') as HTMLFormElement;
  const letters = document.getElementById('letters')!;
  const error = document.getElementById('gate-error')!;

  function tick() {
    for (const el of document.querySelectorAll<HTMLElement>('.countdown')) {
      const distance = new Date(el.dataset.until!).getTime() - Date.now();
      if (distance < 0) {
        el.textContent = el.dataset.done!;
        continue;
      }
      const d = Math.floor(distance / 86_400_000);
      const h = Math.floor((distance % 86_400_000) / 3_600_000);
      const m = Math.floor((distance % 3_600_000) / 60_000);
      const s = Math.floor((distance % 60_000) / 1000);
      el.textContent = `${d}d ${h}h ${m}m ${s}s${el.dataset.msg}`;
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const ok = (form.elements.namedItem('password') as HTMLInputElement).value === 'LikeSoGood';
    error.hidden = ok;
    if (!ok) return;
    form.hidden = true;
    letters.hidden = false;
    tick();
    setInterval(tick, 1000);
  });
</script>

<style>
  .gate {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 10px;
  }

  .gate input,
  .gate button {
    font: inherit;
    padding: 4px 8px;
    border: 1px solid #9ab;
    border-radius: 4px;
    background: #fff;
  }

  .gate button {
    cursor: pointer;
  }

  .error {
    flex-basis: 100%;
    margin: 0;
    color: #c62828;
  }

  .countdown {
    text-align: center;
    color: #008080;
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 1rem;
  }
</style>

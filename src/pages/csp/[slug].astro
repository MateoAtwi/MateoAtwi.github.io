---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Pager from '../../components/Pager.astro';
import { cspThumb, getCspPosts } from '../../lib/content';
import { excerpt, formatDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCspPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[i - 1] && { href: `/csp/${posts[i - 1].id}/`, title: posts[i - 1].data.title },
      next: posts[i + 1] && { href: `/csp/${posts[i + 1].id}/`, title: posts[i + 1].data.title },
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={excerpt(entry.body ?? '', 30)}
  image={cspThumb(entry.data.thumbnail, 1200)}
  meta={`${formatDate(entry.data.date)} - Mateo Atwi`}
  section="/collections/"
>
  <div class="prose blogger">
    <Content />
  </div>
  <Pager slot="after" prev={prev} next={next} back={{ href: '/csp/', title: 'Back to the China Summer Program blog' }} />
</Article>

---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Pager from '../../components/Pager.astro';
import { cspThumb, getCspPosts } from '../../lib/content';
import { excerpt, formatDate, isoDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCspPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[i - 1] && { href: `/csp/${posts[i - 1].id}/`, title: posts[i - 1].data.title },
      next: posts[i + 1] && { href: `/csp/${posts[i + 1].id}/`, title: posts[i + 1].data.title },
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={excerpt(entry.body ?? '', 30)}
  image={cspThumb(entry.data.thumbnail, 1200)}
  back={{ href: '/csp/', label: 'China Summer Program' }}
>
  <p class="eyebrow" slot="lede">
    <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
  </p>
  <div class="prose blogger">
    <Content />
  </div>
  <Pager slot="after" prev={prev} next={next} prevLabel="Previous day" nextLabel="Next stop" />
</Article>

<style>
  .eyebrow {
    margin-top: 1rem;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { cspThumb, getCspPosts } from '../../lib/content';
import { excerpt, formatDate } from '../../lib/format';

const posts = await getCspPosts();
---

<Base
  title="China Summer Program Blog"
  section="/collections/"
  description="Mateo Atwi's 2017 China Summer Program blog: Tianjin, Beijing, Xi'an, Shenzhen, Guilin, Hong Kong, Hangzhou, Shanghai and more."
>
  <article class="card">
    <h1>China Summer Program Blog</h1>
    <p>Posts from the summer of 2017, when Tiago and I traveled across China with the Georgia Tech China Summer Program.</p>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            {post.data.thumbnail && <img src={cspThumb(post.data.thumbnail, 160)} alt="" width="72" height="72" loading="lazy" decoding="async" />}
            <div>
              <h2>
                <a href={`/csp/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post-meta">{formatDate(post.data.date)}</p>
              <p>{excerpt(post.body ?? '', 60)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </article>
</Base>

<style>
  .post-list {
    list-style: none;
    margin-left: 0;
  }

  .post-list li {
    display: flex;
    gap: 15px;
    align-items: flex-start;
    padding-block: 15px;
  }

  .post-list li + li {
    border-top: 1px solid #c3dbe6;
  }

  .post-list img {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 50%;
    max-width: none;
    margin: 0;
  }

  .post-list h2 {
    font-size: 22px;
  }
</style>

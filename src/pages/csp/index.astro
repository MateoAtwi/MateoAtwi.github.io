---
import Base from '../../layouts/Base.astro';
import { cspThumb, getCspPosts } from '../../lib/content';
import { excerpt, formatDate, isoDate } from '../../lib/format';

const posts = await getCspPosts();
---

<Base title="China Summer Program" description="Mateo Atwi's 2017 China Summer Program blog: Tianjin, Beijing, Xi'an, Shenzhen, Guilin, Hong Kong, Hangzhou, Shanghai and more.">
  <header class="wrap page-head">
    <a class="back" href="/collections/">← Collections</a>
    <p class="eyebrow"><span class="dot"></span>Travel · Summer 2017</p>
    <h1>China Summer Program</h1>
    <p class="lede">
      Ten weeks across China with Georgia Tech's China Summer Program: {posts.length} posts written along the way, from the
      first day in Tianjin to the Yangtze River and Zhangjiajie.
    </p>
  </header>

  <ol class="wrap posts">
    {
      posts.map((post, i) => (
        <li>
          <article>
            <span class="num mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="text">
              <time class="eyebrow" datetime={isoDate(post.data.date)}>
                {formatDate(post.data.date)}
              </time>
              <h2>
                <a href={`/csp/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{excerpt(post.body ?? '', 32)}</p>
            </div>
            {post.data.thumbnail && <img src={cspThumb(post.data.thumbnail, 320)} alt="" loading="lazy" decoding="async" width="160" height="160" />}
          </article>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--muted);
  }

  .back:hover {
    color: var(--accent);
  }

  .posts {
    list-style: none;
    margin-block: 0;
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 1rem 1.5rem;
    align-items: start;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .num {
    color: var(--accent);
    padding-top: 0.1rem;
  }

  h2 {
    font-size: 1.3rem;
    margin-top: 0.35rem;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  article:hover h2 a {
    color: var(--accent);
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 40rem;
  }

  img {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  @media (max-width: 36rem) {
    article {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .num {
      display: none;
    }
    img {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>

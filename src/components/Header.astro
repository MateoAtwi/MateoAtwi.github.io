---
import { NAV } from '../lib/site';

interface Props {
  section?: string;
}

const path = decodeURI(Astro.url.pathname).replace(/\/?$/, '/');
const active = Astro.props.section ?? NAV.find((item) => item.href !== '/' && path.startsWith(item.href))?.href ?? (path === '/' ? '/' : undefined);
---

<header class="site-header">
  <div class="wrapper">
    <nav class="site-nav" aria-label="Primary">
      <button class="menu-button" type="button" popovertarget="site-menu" aria-controls="site-menu">
        <svg viewBox="0 0 18 15" width="18" height="15" aria-hidden="true">
          <path
            d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0 h15.032C17.335,0,18,0.665,18,1.484L18,1.484z M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0 c0-0.82,0.665-1.484,1.484-1.484h15.032C17.335,6.031,18,6.696,18,7.516L18,7.516z M18,13.516C18,14.335,17.335,15,16.516,15H1.484 C0.665,15,0,14.335,0,13.516l0,0c0-0.82,0.665-1.483,1.484-1.483h15.032C17.335,12.031,18,12.695,18,13.516L18,13.516z"
          ></path>
        </svg>
        <span>Menu</span>
      </button>
      <ul id="site-menu" class="site-menu" popover="auto">
        {
          NAV.map((item) => (
            <li>
              <a
                class="page-link"
                href={item.href}
                aria-current={path === item.href ? 'page' : active === item.href ? 'true' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-top: 5px solid var(--header-border);
    border-bottom: 1px solid var(--header-border);
    background-color: var(--header-bg);
    min-height: 56px;
    position: relative;
  }

  .wrapper {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 50px;
  }

  .site-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .page-link {
    display: block;
    color: #fff;
    line-height: 1.5;
  }

  .page-link:visited {
    color: #fff;
  }

  .page-link:hover {
    color: #fff;
    text-decoration: underline;
  }

  .page-link[aria-current] {
    opacity: 0.55;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .menu-button {
    display: none;
  }

  /* Wide: the links sit inline on the right of the indigo bar */
  @media (min-width: 601px) {
    .site-menu {
      display: flex;
      gap: 20px;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      overflow: visible;
      border: 0;
      background: transparent;
      color: inherit;
    }
  }

  /* Narrow: a menu button opens the links in a dropdown panel */
  @media (max-width: 600px) {
    .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      font: inherit;
      color: var(--grey-dark);
      background: var(--background);
      border: 1px solid var(--grey-light);
      border-radius: 5px;
      cursor: pointer;
    }

    .menu-button svg {
      fill: var(--grey-dark);
    }

    .site-menu {
      position: fixed;
      inset: auto;
      top: 58px;
      right: 15px;
      min-width: 13rem;
      margin: 0;
      padding: 6px 0;
      background: var(--background);
      border: 1px solid var(--grey-light);
      border-radius: 5px;
      box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
      text-align: right;
    }

    .site-menu .page-link {
      color: var(--text);
      padding: 8px 16px;
    }

    .site-menu .page-link[aria-current] {
      opacity: 1;
      color: var(--header-bg);
      font-weight: 600;
      text-decoration: none;
      box-shadow: inset -3px 0 0 var(--header-bg);
    }

    .site-menu .page-link:hover {
      background: var(--card);
      text-decoration: none;
    }
  }
</style>

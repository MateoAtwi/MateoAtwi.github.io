---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatMonth, isoDate, plainText } from '../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: H = 'h3' } = Astro.props;
const { title, date, slug, summary, thumbnail } = project.data;
---

<article class="card">
  <div class="thumb blueprint">
    {thumbnail ? <Image src={thumbnail} alt="" widths={[400, 720]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw" /> : <span class="placeholder mono" aria-hidden="true">{title.slice(0, 2).toUpperCase()}</span>}
  </div>
  <div class="body">
    <time class="eyebrow" datetime={isoDate(date)}>{formatMonth(date)}</time>
    <H class="title"><a href={`/${slug}/`}>{title}</a></H>
    <p class="summary">{plainText(summary)}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    background-color: var(--surface-2);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--muted);
    opacity: 0.6;
  }

  .body {
    padding: 1.1rem 1.2rem 1.3rem;
    display: grid;
    gap: 0.45rem;
  }

  .title {
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole card is clickable via the heading link */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    line-clamp: 4;
    overflow: hidden;
  }
</style>

---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{SITE.title}</p>
      <p class="muted">Engineer &amp; builder.</p>
    </div>
    <ul class="links">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
      <li><a href="https://usframefactory.com/">US Frame Factory</a></li>
      <li><a href="/feed.xml">RSS</a></li>
    </ul>
    <p class="muted fine">
      © {year} {SITE.title}. I dedicate this website and my work to God's glory and honor.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 3rem;
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 1fr auto;
    }
    .fine {
      grid-column: 1 / -1;
    }
  }

  p {
    margin: 0;
  }

  .name {
    font-weight: 700;
  }

  .muted {
    color: var(--muted);
  }

  .fine {
    font-size: 0.8125rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: start;
  }

  .links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
  }

  .links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

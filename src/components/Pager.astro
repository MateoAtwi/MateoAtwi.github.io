---
interface Link {
  href: string;
  title: string;
}
interface Props {
  prev?: Link;
  next?: Link;
  prevLabel?: string;
  nextLabel?: string;
}
const { prev, next, prevLabel = 'Previous', nextLabel = 'Next' } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="More posts">
      {prev ? (
        <a class="prev" href={prev.href}>
          <span class="eyebrow">← {prevLabel}</span>
          <span class="t">{prev.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" href={next.href}>
          <span class="eyebrow">{nextLabel} →</span>
          <span class="t">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    max-width: var(--prose);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s ease;
  }

  a:hover {
    border-color: var(--accent);
  }

  .next {
    text-align: end;
  }

  .t {
    font-weight: 650;
    line-height: 1.3;
  }
</style>

---
interface Link {
  href: string;
  title: string;
}
interface Props {
  prev?: Link;
  next?: Link;
  prevLabel?: string;
  nextLabel?: string;
  back?: Link;
}
const { prev, next, prevLabel = 'Previous', nextLabel = 'Next', back } = Astro.props;
---

<nav class="pager" aria-label="More pages">
  <hr />
  <div class="row">
    <span>{prev && <a href={prev.href}>← {prevLabel}: {prev.title}</a>}</span>
    <span class="end">{next && <a href={next.href}>{nextLabel}: {next.title} →</a>}</span>
  </div>
  {back && <p class="back"><a href={back.href}>{back.title}</a></p>}
</nav>

<style>
  .pager {
    margin-top: 2em;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 10px;
  }

  .end {
    margin-left: auto;
    text-align: right;
  }

  .back {
    margin-top: 8px;
    text-align: center;
  }
</style>
